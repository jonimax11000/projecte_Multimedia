# =============================================
# DEPENDENCIAS Y PACKAGE MANAGERS
# =============================================
**/node_modules/
**/npm-debug.log*
**/yarn-debug.log*
**/yarn-error.log*
**/package-lock.json
**/yarn.lock
**/pnpm-lock.yaml

# =============================================
# BUILD Y COMPILACIÓN TYPESCRIPT
# =============================================
**/dist/
**/build/
**/*.tsbuildinfo
**/out/
**/.next/
**/.nuxt/

# =============================================
# VARIABLES DE ENTORNO
# =============================================
**/.env
**/.env.*
!**/.env.example

# =============================================
# LOGS
# =============================================
**/*.log
**/logs/
**/npm-debug.log*
**/yarn-debug.log*
**/yarn-error.log*
**/lerna-debug.log*

# =============================================
# CACHÉ Y TEMPORALES
# =============================================
**/.cache/
**/.parcel-cache/
**/.rpt2_cache/
**/.rts2_cache_*/
**/.eslintcache
**/.npm
**/tmp/
**/temp/

# =============================================
# COVERAGE Y TESTS
# =============================================
**/coverage/
**/.nyc_output/
**/*.lcov

# =============================================
# ARCHIVOS DEL SISTEMA
# =============================================
**/.DS_Store
**/Thumbs.db
**/ehthumbs.db
**/Desktop.ini
**/$RECYCLE.BIN/
**/.Trashes
**/._*

# =============================================
# IDEs Y EDITORES
# =============================================
**/.vscode/
**/.idea/
**/*.swp
**/*.swo
**/*~
**/.vs/

# =============================================
